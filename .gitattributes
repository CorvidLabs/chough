# .3md is Markdown with a Z axis. GitHub Linguist treats a leading dot as a
# troff macro and .3* names as man pages, so these files show up as Roff.
# The Markdown preview also joins a single newline into a space and glues the
# planes into one paragraph. Plain text keeps each plane on its own line.
*.3md linguist-language=Text

.chough/session.json merge=chough-session
.chough/sessions/*.json merge=chough-session
.chough/sessions/archive/*.json merge=chough-session

# Append-only JSON lines and changelog bullets merge by keeping both sides' lines
# (DRIVE-12).
.chough/pruned.jsonl merge=union
CHANGELOG.md merge=union

# Bug records merge field by field. The notes `chough library index` generates are
# union-merged and rebuilt (`library index --check` in the verify lane), DRIVE-12;
# attachments, snapshots, briefs and the README are not generated, so they still conflict.
.chough/bugs/*.json merge=chough-bug
knowledge/INDEX.md merge=union
knowledge/rules.md merge=union
knowledge/timeline.md merge=union
knowledge/timeline/*.md merge=union
knowledge/archives/*.md merge=union
knowledge/modules/*.md merge=union
knowledge/intent/*.md merge=union
