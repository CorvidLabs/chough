# Script (run with CHOUGH=target/debug/chough SRC=<checkout>)
#!/bin/sh
# Issue #38 reproduction: stage advance while an awaiting-human gate is open.
set -eu
chough=${CHOUGH:?set CHOUGH}
src=${SRC:?set SRC to the chough checkout}
work=$(mktemp -d /tmp/chough-exercise.XXXXXX)
cp -R "$src/examples/shipping/." "$work/"
cd "$work"
git -c init.defaultBranch=main init -q
git config user.name "Chough repro"; git config user.email repro@example.invalid; git config commit.gpgsign false
$chough init --objective "Repro #38" --intent-scope CHECKOUT --module shipping >/dev/null
git add -A; git commit -qm seed
$chough checkpoint --awaiting-human "Intent approval of CHECKOUT-2" >/dev/null
echo "== stage advance at intent with an open gate"
set +e; $chough stage advance --note "repro" | jq -c .applied; echo "exit $?"; set -e
echo "stage: $(jq -r .stage.current .chough/session.json); awaiting: $(jq -c .awaiting_human .chough/session.json)"
echo "== chough next"; $chough next | sed -n '1,6p' | rg "Stage|Next"
$chough stage advance --note "to plan" >/dev/null 2>&1 || true
$chough checkpoint --clear-awaiting-human --awaiting-human "Scope approval of x" >/dev/null
echo "== stage skip at $(jq -r .stage.current .chough/session.json) with an open gate (SDD off)"
set +e; $chough stage skip --reason "repro" | jq -c .applied; echo "exit $?"; set -e
echo "stage: $(jq -r .stage.current .chough/session.json)"
rm -rf "$work"
