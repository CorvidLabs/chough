# Script (run with CHOUGH=target/debug/chough SRC=<checkout>)
#!/bin/sh
# Issue #39 reproduction: test -> accept with a failed, unlinked case observation.
set -eu
chough=${CHOUGH:?set CHOUGH}
src=${SRC:?set SRC to the chough checkout}
work=$(mktemp -d /tmp/chough-exercise.XXXXXX)
cp -R "$src/examples/shipping/." "$work/"
cd "$work"
git -c init.defaultBranch=main init -q
git config user.name "Chough repro"; git config user.email repro@example.invalid; git config commit.gpgsign false
$chough init --objective "Repro #39" --intent-scope CHECKOUT --module shipping >/dev/null
git add -A; git commit -qm seed
for s in 1 2 3 4; do $chough stage advance --note "repro: ungated sample" | jq -r '.applied | "\(.from) -> \(.to) (gate \(.gate))"'; done
$chough checkpoint --case TC-shipping-0002 >/dev/null
$chough evidence add --case TC-shipping-0002 --criterion CHECKOUT-2 --requirement REQ-shipping-001 \
  --contract specs/shipping/shipping.spec.md --kind product-test --outcome failed \
  --environment repro-local --method automated --track functional \
  --summary "Repro: TC-shipping-0002 failed and no bug was recorded" | jq -r .recorded
echo "== bugs linking it: $($chough bug list --all | jq '[.. | objects | select(has("observations"))] | length')"
echo "== chough next (stage test)"; $chough next --environment repro-local | sed -n '1,12p'
echo "== stage advance from test"
set +e; $chough stage advance --note "repro: leave test with an unlinked failure"; echo "exit $?"; set -e
jq -r .stage.current .chough/session.json
rm -rf "$work"
